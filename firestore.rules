rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function validFichaOpme(data) {
      return data.filial == 'CGR'
        && data.paciente is string
        && data.paciente.size() > 1
        && data.medico is string
        && data.medico.size() > 1
        && data.procedimento is string
        && data.procedimento.size() > 1
        && data.status is int
        && data.status >= 0
        && data.status <= 5
        && data.itens is list;
    }

    match /procedimentos_cg/{docId} {
      allow read, write: if signedIn();
    }

    match /fichas_opme/{docId} {
      allow read: if signedIn() && (!resource.data.keys().hasAny(['filial']) || resource.data.filial == 'CGR');
      allow create, update: if signedIn() && validFichaOpme(request.resource.data);
      allow delete: if signedIn() && resource.data.filial == 'CGR';
    }

    match /fichas_opme_cgr/{docId} {
      allow read: if signedIn();
      allow write: if false;
    }
  }
}
